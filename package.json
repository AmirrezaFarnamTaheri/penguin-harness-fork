{
  "name": "penguin-harness",
  "version": "0.2.16",
  "private": true,
  "type": "module",
  "description": "PenguinHarness — TypeScript AI Agent (SDK + CLI).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "check:i18n": "node scripts/check-i18n.mjs",
    "verify:benchmark-data": "node scripts/verify-benchmark-data.mjs",
    "skills:audit": "node scripts/skills/audit.mjs",
    "skills:check": "node scripts/skills/audit.mjs --check",
    "skills:catalog": "node scripts/skills/catalog.mjs --json=artifacts/skill-catalog.json --markdown=artifacts/skill-catalog.md",
    "skills:readiness": "node scripts/skills/readiness.mjs --json=artifacts/skill-readiness.json --markdown=artifacts/skill-readiness.md",
    "skills:normalize": "node scripts/skills/normalize-frontmatter.mjs --write",
    "skills:normalize:check": "node scripts/skills/normalize-frontmatter.mjs",
    "skills:aliases:check": "node scripts/skills/sync-aliases.mjs",
    "skills:aliases:prune": "node scripts/skills/sync-aliases.mjs --write --prune-dangling",
    "skills:names:check": "node scripts/skills/normalize-names.mjs --bilingual-experts --core-disambiguation",
    "skills:names:normalize": "node scripts/skills/normalize-names.mjs --write --bilingual-experts --core-disambiguation",
    "gen:ifaces": "node scripts/gen-ifaces.mjs --project packages/server/tsconfig.json --out packages/server/src/ifaces.json",
    "gen:ifaces:watch": "node scripts/gen-ifaces.mjs --project packages/server/tsconfig.json --out packages/server/src/ifaces.json --watch",
    "ifaces:page": "pnpm gen:ifaces && node scripts/iface-page.mjs --in packages/server/src/ifaces.json --out dist-ifaces",
    "typecheck": "pnpm gen:ifaces && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @prismshadow/penguin-core test:e2e",
    "benchmark:tool-exposure": "pnpm --filter @prismshadow/penguin-core build && node scripts/benchmark-tool-exposure.mjs",
    "eval:tool-exposure": "pnpm --filter @prismshadow/penguin-core build && node --env-file-if-exists=.env scripts/eval-tool-exposure.mjs",
    "build": "pnpm -r build && pnpm link:cli",
    "link:cli": "pnpm --dir packages/cli link --global || echo '[link:cli] pnpm global directory not configured; skipping the global penguin link (run pnpm setup once first)'",
    "penguin": "node scripts/run-with-env.mjs PENGUIN_HOME=~/.penguin/dev-data-cli PORT=7369 -- tsx packages/cli/src/penguin.ts",
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "pnpm --filter @prismshadow/penguin-server dev",
    "dev:web": "node scripts/dev-prebuild.mjs && pnpm --filter @prismshadow/penguin-web dev",
    "dev:docs": "node scripts/dev-prebuild.mjs --install-only && pnpm --filter @prismshadow/penguin-docs dev",
    "dev:landing": "node scripts/dev-prebuild.mjs --install-only && pnpm --filter @prismshadow/penguin-landing dev",
    "build:site": "node scripts/build-site.mjs",
    "desktop": "pnpm -r build && node scripts/run-with-env.mjs PENGUIN_HOME=~/.penguin/dev-data -- pnpm --dir packages/desktop start"
  },
  "devDependencies": {
    "@prismshadow/penguin-cli": "workspace:*",
    "@prismshadow/penguin-core": "workspace:*",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.4",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.18.0"
}
