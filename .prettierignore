# build output and dependencies
node_modules/
dist/
pnpm-lock.yaml
# the assembled app directory some branches stage before packing (packages/desktop/.gitignore
# ignores it there; prettier does not read .gitignore, so it needs saying again here)
packages/desktop/stage/

# desktop build output: the installers electron-builder writes, and the assets
# scripts/build-assets.mjs copies in beside them (formatted in their own packages)
packages/desktop/out/
packages/desktop/skills/

# Imported third-party skill corpus. Preserve upstream formatting and avoid
# rewriting vendored templates, fixtures, schemas, examples, and generated assets.
.agents/skills/

# All Markdown is excluded by design: the READMEs are hand-formatted prose (much of it
# Chinese) and every skill's SKILL.md keeps the formatting of the upstream corpus it was
# imported from. `pnpm format:check` therefore governs code, not prose.
*.md

