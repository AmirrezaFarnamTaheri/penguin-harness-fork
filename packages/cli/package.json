{
  "name": "@prismshadow/penguin-cli",
  "version": "0.2.18",
  "type": "module",
  "description": "PenguinHarness CLI: interactive REPL and single-task runner over @prismshadow/penguin-core.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "packages/cli"
  },
  "bin": {
    "penguin": "./dist/penguin.js",
    "penguin-hmr": "./dist/penguin-hmr.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsup",
    "penguin": "node ../../scripts/run-with-env.mjs PENGUIN_HOME=~/.penguin/dev-data-cli PORT=7369 -- tsx src/penguin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@penguinharness/agent-company": "workspace:*",
    "@penguinharness/agent-development": "workspace:*",
    "@penguinharness/agent-tuning": "workspace:*",
    "@penguinharness/continual-learning": "workspace:*",
    "@penguinharness/data-analysis": "workspace:*",
    "@penguinharness/goal": "workspace:*",
    "@penguinharness/humanizer": "workspace:*",
    "@penguinharness/model-development": "workspace:*",
    "@penguinharness/skill-porting": "workspace:*",
    "@penguinharness/software-development": "workspace:*",
    "@penguinharness/use-bento-slides": "workspace:*",
    "@penguinharness/use-claude-code": "workspace:*",
    "@penguinharness/use-firecrawl": "workspace:*",
    "@penguinharness/use-spexcode": "workspace:*",
    "@prismshadow/agenthub": "^0.4.12",
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-server": "workspace:*",
    "commander": "^13.1.0",
    "dotenv": "^17.4.2",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
