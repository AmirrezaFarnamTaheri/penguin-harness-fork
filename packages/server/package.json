{
  "name": "@prismshadow/penguin-server",
  "version": "0.2.18",
  "type": "module",
  "description": "PenguinHarness web server: multi-user authentication and authorization, Session execution with SSE streaming, and usage accounting, built on @prismshadow/penguin-core.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "packages/server"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/types.d.ts",
      "import": "./dist/api/types.js"
    },
    "./machine-status": {
      "types": "./dist/machine-status.d.ts",
      "import": "./dist/machine-status.js"
    },
    "./lock": {
      "types": "./dist/lock.d.ts",
      "import": "./dist/lock.js"
    },
    "./initial-password": {
      "types": "./dist/initial-password.d.ts",
      "import": "./dist/initial-password.js"
    },
    "./reset-admin-password": {
      "types": "./dist/reset-admin-password.d.ts",
      "import": "./dist/reset-admin-password.js"
    },
    "./hmr/manifest": {
      "types": "./dist/hmr/manifest.d.ts",
      "import": "./dist/hmr/manifest.js"
    },
    "./version-report": {
      "types": "./dist/version-report.d.ts",
      "import": "./dist/version-report.js"
    },
    "./auth-token": {
      "types": "./dist/auth-token.d.ts",
      "import": "./dist/auth-token.js"
    },
    "./secret-file": {
      "types": "./dist/secret-file.d.ts",
      "import": "./dist/secret-file.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node ../../scripts/dev-prebuild.mjs && node ../../scripts/run-with-env.mjs PENGUIN_HOME=~/.penguin/dev-data PORT=7368 -- tsx watch src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsup"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@prismshadow/penguin-core": "workspace:*",
    "@xterm/headless": "^5.5.0",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.7",
    "node-pty": "^1.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "smol-toml": "^1.8.0",
    "tar": "^7.5.22",
    "undici": "^7.29.1",
    "unified": "^11.0.5",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist",
    "web-dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
